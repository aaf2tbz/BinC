/* ternary.binc — interpreter port: ternary, comparisons, control flow */
kernel void k(device float* out, coord1D i) {
    float v = (float)i;
    out[i]     = v < 2.0f ? 10.0f : 20.0f;   /* 10 10 20 20 */
    out[i + 4] = i % 2 == 0 ? 1.0f : -1.0f;  /* 1 -1 1 -1 */
    float s = 0.0f;
    for (int j = 0; j <= i; j++) s += (float)j;
    out[i + 8] = s;                          /* 0 1 3 6 */
    int k2 = 0;
    while (k2 < i) k2++;
    out[i + 12] = (float)k2;                 /* 0 1 2 3 */
}
