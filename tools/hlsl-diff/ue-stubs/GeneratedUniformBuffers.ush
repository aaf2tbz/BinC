// Vertex-factory interpolants struct: defined per-factory by the generated
// VertexFactory.ush (missing from the audit include chain). The base-pass
// reachable code only passes it through, so a minimal registered struct
// suffices for acceptance.
struct FVertexFactoryInterpolantsVSToPS
{
    float4 _data;
};

// UE's interleaved gradient noise (defined outside the reachable include
// chain in this corpus) — the classic hash used for dithered LOD transitions.
float Pow2(float x) { return x * x; }
float2 Pow2(float2 x) { return x * x; }
float3 Pow2(float3 x) { return x * x; }
float4 Pow2(float4 x) { return x * x; }
struct FMaterialAttributes
{
    float4 _data;
};
float InterleavedGradientNoise(float2 PixelCoord, uint FrameIndex)
{
    const float3 Magic = float3(0.06711056f, 0.00583715f, 52.9829189f);
    return frac(dot(PixelCoord, Magic.xy) + FrameIndex * Magic.z);
}

// Checkerboard-dither helper used by Substrate paths (definition outside the
// reachable chain) — parity of the summed pixel coordinates.
bool CheckerFromPixelPos(float2 PixelPos)
{
    return frac((PixelPos.x + PixelPos.y) * 0.5f) < 0.5f;
}
struct FBasePassInterpolantsVSToPS
{
    float4 _data;
};

