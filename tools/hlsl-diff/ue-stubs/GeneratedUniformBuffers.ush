// SCW generator-placeholder substitution: MaterialTemplate.ush's
// FPixelMaterialInputs body is `%{pixel_material_inputs}`, filled at
// generation time. The pp substitutes a live define of that name.
// Fields audited from BasePassPixelShader.usf reachable references.
#define pixel_material_inputs \
    float4 EmissiveColor; \
    float BaseColor; \
    float Metallic; \
    float Specular; \
    float Roughness; \
    float Anisotropy; \
    float Opacity; \
    float AmbientOcclusion; \
    float4 WorldNormal; \
    float4 Normal; \
    float4 Tangent; \
    float4 Refraction; \
    float PixelDepthOffset; \
    uint ShadingModel;

// OpaqueBasePass: per-material SCW define (like WORKING_COLOR_SPACE_*_MAT).
