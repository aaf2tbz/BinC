// Audited from BasePassPixelShader.usf reachable references.
struct FBasePassPlanarReflectionData
{
    float4 ReflectionPlane;
    float4 PlanarReflectionParameters;
    float4 PlanarReflectionOrigin;
    float4 PlanarReflectionXAxis;
    float4 PlanarReflectionYAxis;
    float4 PlanarReflectionParameters2;
};
struct FBasePassSharedData
{
    int UseBasePassSkylight;
    float4 Forward;
    float4 ForwardDirLightShadow;
    float4 Reflection;
    FBasePassPlanarReflectionData PlanarReflection;
    float4 Fog;
    float4 FogISR;
    float4 LightFunctionAtlas;
};
struct FBasePassData
{
    FBasePassSharedData Shared;
    float4 Substrate;
    Texture2D ResolvedSceneDepthTexture;
    bool Is24BitUnormDepthStencil;
    Texture2D PreIntegratedGFTexture;
};
FBasePassData OpaqueBasePass;

