// Stub for the SCW-generated Engine/Generated/UniformBuffers/View.ush.
#pragma once

// The real file is generated per-engine-version by the ShaderCompilerWorker and
// carries the full view uniform state (~200 fields). This stub provides the
// ViewState struct with the fields the vendored shader corpus actually
// references (64 uses across the base-pass material pipeline) plus the
// GetPrimaryView/ResolveView entry points, so the frontend can resolve the
// reachable code. Field types follow the UE ViewState declarations.
#include "/Engine/Private/DoubleFloat.ush"
struct ViewState
{
    float4x4 ViewToClip;
    float3 PrecomputedIndirectLightingColorScale;
    float4x4 TranslatedWorldToClip;
    float4x4 TranslatedWorldToView;
    float4x4 FirstPersonTransform;
    float4x4 PrevFirstPersonTransform;
    float4x4 SVPositionToTranslatedWorld;
    float4 ScreenPositionScaleBias;
    float4 ViewSizeAndInvSize;
    float4 BufferSizeAndInvSize;
    float4 InvDeviceZToWorldZTransform;
    float2 WorldDepthToPixelWorldRadius;
    float4 ScreenRayLengthMultiplier;
    float4 ScreenToViewSpace;
    uint VirtualTextureFeedbackSampleOffset;
    uint VirtualTextureFeedbackMask;
    uint VirtualTextureFeedbackShift;
    uint VirtualTextureFeedbackJitterOffset;
    uint VirtualTextureFeedbackBufferSize;
    uint Random;
    float GlobalVirtualTextureMipBias[4];
    // CommonViewUniformBuffer.ush uses xy as tan(FOV/2) and zw as its
    // reciprocal for current and previous views.
    float4 TanAndInvTanHalfFOV;
    float4 PrevTanAndInvTanHalfFOV;
    // FinalizeViewState (generated CommonView code) constructs these LWC
    // transforms from the high/low origin pairs and relative matrices.
    float3 ViewOriginHigh;
    float3 ViewOriginLow;
    float3 WorldViewOriginHigh;
    float3 WorldViewOriginLow;
    float3 PrevWorldCameraOriginHigh;
    float3 PrevWorldCameraOriginLow;
    float3 PrevWorldViewOriginHigh;
    float3 PrevWorldViewOriginLow;
    float3 PreViewTranslationHigh;
    float3 PreViewTranslationLow;
    float3 PrevPreViewTranslationHigh;
    float3 PrevPreViewTranslationLow;
    float4x4 RelativeWorldToClip;
    float4x4 ClipToRelativeWorld;
    float4x4 ScreenToRelativeWorld;
    float4x4 PrevClipToRelativeWorld;
    FDFInverseMatrix WorldToClip;
    FDFMatrix ClipToWorld;
    float4x4 ClipToView;
    FDFMatrix ScreenToWorld;
    float4x4 ScreenToTranslatedWorld;
    FDFMatrix PrevClipToWorld;
    FDFVector3 PreViewTranslation;
    FDFVector3 PrevPreViewTranslation;
    FDFVector3 WorldCameraOrigin;
    FDFVector3 WorldViewOrigin;
    FDFVector3 PrevWorldCameraOrigin;
    FDFVector3 PrevWorldViewOrigin;
    float3 ViewForward;
    float3 TranslatedWorldCameraOrigin;
    Texture2D SSProfilesTexture;
    SamplerState SSProfilesSampler;
    float4 SSProfilesTextureSizeAndInvSize;
    Texture2D SobolSamplingTexture;
    Texture3D VolumetricLightmapIndirectionTexture;
    float3 AtmosphereLightDirection[2];
    float2 ViewRectMin;
    float2 TemporalAAJitter;
    uint2 TileOffset;
    uint StateFrameIndex;
    uint StateFrameIndexMod8;
    uint StereoPassIndex;
    uint bCheckerboardSubsurfaceProfileRendering;
    uint RenderingReflectionCaptureMask;
    uint bSubsurfacePostprocessEnabled;
    float4 TemporalAAParams;
    float PreExposure;
    float OneOverPreExposure;
    float MaterialMaxEmissiveValue;
};

ViewState ResolvedView;
ViewState View;

ViewState GetPrimaryView()
{
    return ResolvedView;
}
