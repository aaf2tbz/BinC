/* BinC standard prelude — auto-included before every compilation
 * (disable with -no-prelude). Constants and common math wrappers. */
once;

constant float PI  = 3.14159265f;
constant float TAU = 6.28318530f;
constant float E   = 2.71828182f;

/* scalar float wrappers around the fmin/fmax built-ins */
float min(float a, float b) { return fmin(a, b); }
float max(float a, float b) { return fmax(a, b); }

float lerp(float a, float b, float t) { return mix(a, b, t); }
float saturate(float x)               { return clamp(x, 0.0f, 1.0f); }

/* 0-255 RGBA channel packing for uint color buffers (pong-style) */
uint pack_rgba(float4 c) {
    uint r = (uint)(saturate(c.x) * 255.0f);
    uint g = (uint)(saturate(c.y) * 255.0f);
    uint b = (uint)(saturate(c.z) * 255.0f);
    uint a = (uint)(saturate(c.w) * 255.0f);
    return (r << 24) | (g << 16) | (b << 8) | a;
}

float4 unpack_rgba(uint c) {
    return float4((float)((c >> 24) & 0xFFu),
                  (float)((c >> 16) & 0xFFu),
                  (float)((c >> 8)  & 0xFFu),
                  (float)(c & 0xFFu)) / 255.0f;
}

/* deterministic GPU hash — useful for effects and dithering */
float hash12(float2 p) {
    float3 p3 = fract(float3(p.xy, p.x + p.y) * 0.1031f);
    p3 += dot(p3, p3.yzx + 33.33f);
    return fract((p3.x + p3.y) * p3.z);
}
