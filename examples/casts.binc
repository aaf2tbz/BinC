kernel void casts(device float* f, device int* i, device uint* u, coord1D j) {
    float a = 3.75f;
    i[0] = (int)a;                /* 3 (truncation) */
    f[0] = (float)i[0];           /* 3.0 */
    u[0] = (uint)(-1);            /* 0xFFFFFFFF */
    i[1] = (int)7.99f;            /* 7 */
    f[1] = (float)5;              /* 5.0 */
    i[2] = (int)(bool)f[0];       /* 1 */
    i[3] = (int)(bool)0.0f;       /* 0 */
    u[1] = 3;
    f[2] = (float)u[1];           /* 3.0 */
    f[3] = (float)u[0];           /* 4.2949673e9 */
    float4 v = (float4)2.5f;      /* scalar splat */
    f[4] = v.x + v.y + v.z + v.w; /* 10.0 */
    u[2] = (uint)(-2) >> 1;       /* uint shift: 0x7FFFFFFF */
}
