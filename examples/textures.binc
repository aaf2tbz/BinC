kernel void k(device float* out, texture2d<float> tex, sampler smp, coord2D c) {
    /* tex is 4x4, filled texel(x,y) = (x+1, y+1, x+y+1, 1) by the harness */
    int x = c.global.x;
    int y = c.global.y;
    float4 t = tex.read(int2(x, y));            /* direct read */
    out[x + y * 4] = t.x + t.y;                 /* (x+1)+(y+1) = x+y+2 */
    float2 uv = float2((x + 0.5f) / 4.0f, (y + 0.5f) / 4.0f);
    float4 s = tex.sample(smp, uv);             /* nearest: picks texel (x,y) */
    out[16 + x + y * 4] = s.z;                  /* x+y+1 */
    tex.write(float4(9.0f), int2(x, y));        /* write; verified by host readback after dispatch */
}
