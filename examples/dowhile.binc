kernel void k(device int* out, coord1D i) {
    int x = i;
    int count = 0;
    do {
        count += 1;
        x = x >> 1;
    } while (x > 0);
    out[i] = count;             /* floor(log2(i))+1, 1 for i == 0 */
    int y = 0;
    do {
        y += 2;
        if (y > 8) break;
    } while (y < 100);
    out[i + 8] = y;             /* 10 for every thread */
}
