/* BinC owns the complete game: simulation, physics, rounds, lives, scoreboard,
 * 3-D arena geometry, timer, particles, vertex stage, and atmosphere. */
struct Game {
    float ballx, bally, ballz, vx, vy, vz;
    float left, right, trail, clock, round_time;
    int round, lives, flash, event, player_score, ai_score, game_over;
};

void rect3(device float4* v, int b, float cx, float cy, float z, float hw, float hh) {
    v[b + 0] = float4(cx - hw, cy - hh, z, 1.0f);
    v[b + 1] = float4(cx + hw, cy - hh, z, 1.0f);
    v[b + 2] = float4(cx + hw, cy + hh, z, 1.0f);
    v[b + 3] = float4(cx - hw, cy - hh, z, 1.0f);
    v[b + 4] = float4(cx + hw, cy + hh, z, 1.0f);
    v[b + 5] = float4(cx - hw, cy + hh, z, 1.0f);
}

void streak3(device float4* v, int b, float x1, float y1, float x2, float y2, float z, float width) {
    float dx = x2 - x1; float dy = y2 - y1; float len = sqrt(dx * dx + dy * dy);
    float nx = -dy / len * width; float ny = dx / len * width;
    v[b + 0] = float4(x1 + nx, y1 + ny, z, 1.0f);
    v[b + 1] = float4(x2 + nx, y2 + ny, z, 1.0f);
    v[b + 2] = float4(x2 - nx, y2 - ny, z, 1.0f);
    v[b + 3] = float4(x1 + nx, y1 + ny, z, 1.0f);
    v[b + 4] = float4(x2 - nx, y2 - ny, z, 1.0f);
    v[b + 5] = float4(x1 - nx, y1 - ny, z, 1.0f);
}

void continue_from_left(device Game* g) {
    g[0].ballx = -0.75f; g[0].vx = fabs(g[0].vx); g[0].round_time = 30.0f;
}

void continue_from_right(device Game* g) {
    g[0].ballx = 0.75f; g[0].vx = -fabs(g[0].vx); g[0].round_time = 30.0f;
}

void arena(device float4* v, int b, int round, float clock) {
    int theme = (round / 5) % 6;
    float bgz = 0.8984375f + theme * 0.015625f + 0.00390625f * sin(clock * 2.0f);
    rect3(v, b, 0.0f, 0.0f, bgz, 1.0f, 1.0f);
    rect3(v, b + 6, 0.0f, -0.75f, 0.75f, 0.875f, 0.0078125f);
    rect3(v, b + 12, 0.0f, -0.5f, 0.6875f, 0.875f, 0.0078125f);
    rect3(v, b + 18, 0.0f, -0.25f, 0.625f, 0.875f, 0.0078125f);
    rect3(v, b + 24, 0.0f, 0.0f, 0.5625f, 0.875f, 0.0078125f);
    rect3(v, b + 30, 0.0f, 0.25f, 0.5f, 0.875f, 0.0078125f);
    rect3(v, b + 36, 0.0f, 0.5f, 0.4375f, 0.875f, 0.0078125f);
    rect3(v, b + 42, 0.0f, 0.75f, 0.375f, 0.875f, 0.0078125f);
    rect3(v, b + 48, -0.75f, 0.0f, 0.5f, 0.0078125f, 0.875f);
    rect3(v, b + 54, -0.5f, 0.0f, 0.4375f, 0.0078125f, 0.875f);
    rect3(v, b + 60, -0.25f, 0.0f, 0.375f, 0.0078125f, 0.875f);
    rect3(v, b + 66, 0.25f, 0.0f, 0.375f, 0.0078125f, 0.875f);
    rect3(v, b + 72, 0.5f, 0.0f, 0.4375f, 0.0078125f, 0.875f);
    rect3(v, b + 78, 0.75f, 0.0f, 0.5f, 0.0078125f, 0.875f);
    rect3(v, b + 84, 0.0f, 0.875f, 0.25f, 0.03125f + round * 0.00390625f, 0.015625f);
}

kernel void update(device Game* g, device float4* vertices, float dt, float input) {
    g->event = 0;
    g->clock += dt;
    g->round_time -= dt;
    float factor = pow(1.25f, g->round - 1);
    float paddle_speed = 1.125f * factor;
    g->trail = g->ballx;
    g->ballx += g->vx * factor * dt;
    g->bally += g->vy * factor * dt;
    g->ballz += g->vz * dt;
    g->vz -= 0.75f * dt;
    g->left += input * paddle_speed * dt;
    /* The AI deliberately misses on a deterministic 5% slice of its cycle. */
    float ai_roll = (0.5f + 0.5f * sin(g->clock * 3.0f + g->round)) * 100.0f;
    if (ai_roll > 5.0f) {
        if (g->right < g->bally) g->right += paddle_speed * dt;
        if (g->right > g->bally) g->right -= paddle_speed * dt;
    }
    if (g->left > 0.75f) g->left = 0.75f;
    if (g->left < -0.75f) g->left = -0.75f;
    if (g->right > 0.75f) g->right = 0.75f;
    if (g->right < -0.75f) g->right = -0.75f;
    if (g->bally > 0.875f || g->bally < -0.875f) { g->vy = -g->vy; g->event = 1; }
    if (g->ballz > 0.375f || g->ballz < 0.0625f) g->vz = -g->vz;
    /* Impact angle follows the side of the paddle that was hit. */
    if (g->ballx < -0.75f && fabs(g->bally - g->left) < 0.25f) {
        float impact = g->bally - g->left;
        if (impact > 0.125f) g->vy = fabs(g->vy);
        if (impact < -0.125f) g->vy = -fabs(g->vy);
        g->vx = fabs(g->vx); g->event = 1;
    }
    if (g->ballx > 0.75f && fabs(g->bally - g->right) < 0.25f) {
        float impact = g->bally - g->right;
        if (impact > 0.125f) g->vy = fabs(g->vy);
        if (impact < -0.125f) g->vy = -fabs(g->vy);
        g->vx = -fabs(g->vx); g->event = 1;
    }
    /* Passing the player costs a life and restarts the current round at its current speed. */
    if (g->ballx < -1.0f) {
        g->lives -= 1; g->ai_score += 1; g->event = 2; g->flash = 1; continue_from_left(g);
        if (g->lives < 1 || g->ai_score >= 5) { g->game_over = 1; g->round = 0; }
    }
    /* A right-side score advances the round without teleporting the ball to center. */
    if (g->ballx > 1.0f) {
        g->player_score += 1; g->round += 1; g->event = 3; g->flash = 2; continue_from_right(g);
        if (g->player_score >= 5) g->game_over = 2;
    } else if (g->round_time < 0.0f) {
        /* A timeout only accelerates the current flight; it never resets the ball. */
        g->round += 1; g->round_time = 30.0f; g->event = 3; g->flash = 2;
    }

    arena(vertices, 0, g->round, g->clock);
    /* Smooth, tapered motion smear: three overlapping ribbons, not persistent echo sprites. */
    streak3(vertices, 90, g->ballx - g->vx * factor * 0.375f, g->bally - g->vy * factor * 0.375f, g->ballx, g->bally, 0.34375f, 0.0234375f);
    streak3(vertices, 96, g->ballx - g->vx * factor * 0.25f, g->bally - g->vy * factor * 0.25f, g->ballx, g->bally, 0.28125f, 0.015625f);
    streak3(vertices, 102, g->ballx - g->vx * factor * 0.125f, g->bally - g->vy * factor * 0.125f, g->ballx, g->bally, 0.21875f, 0.0078125f);
    rect3(vertices, 108, 2.0f, 2.0f, 0.25f, 0.0078125f, 0.0078125f);
    rect3(vertices, 114, 2.0f, 2.0f, 0.25f, 0.0078125f, 0.0078125f);
    rect3(vertices, 120, 2.0f, 2.0f, 0.25f, 0.0078125f, 0.0078125f);
    rect3(vertices, 126, -0.875f, g->left, 0.125f, 0.03125f, 0.25f);
    rect3(vertices, 132, 0.875f, g->right, 0.125f, 0.03125f, 0.25f);
    rect3(vertices, 138, g->ballx, g->bally, g->ballz, 0.046875f, 0.046875f);
    /* Timer: ten GPU bars at the top edge of the playfield. */
    for (int i = 0; i < 10; i += 1) {
        if (i * 3 < g->round_time) rect3(vertices, 144 + i * 6, -0.25f + i * 0.0546875f, 0.953125f, 0.28125f, 0.0234375f, 0.0078125f);
        else rect3(vertices, 144 + i * 6, 2.0f, 2.0f, 0.0625f, 0.0078125f, 0.0078125f);
    }
    /* Lives and compact score bars are GPU-generated HUD geometry. */
    for (int i = 0; i < 3; i += 1) {
        if (i < g->lives) rect3(vertices, 204 + i * 6, -0.75f + i * 0.046875f, 0.875f, 0.125f, 0.015625f, 0.015625f);
        else rect3(vertices, 204 + i * 6, 2.0f, 2.0f, 0.125f, 0.015625f, 0.015625f);
    }
    for (int i = 0; i < 5; i += 1) {
        if (i < g->player_score % 6) rect3(vertices, 222 + i * 6, -0.5f + i * 0.03125f, 0.875f, 0.0625f, 0.01171875f, 0.0078125f);
        else rect3(vertices, 222 + i * 6, 2.0f, 2.0f, 0.0625f, 0.0078125f, 0.0078125f);
        if (i < g->ai_score % 6) rect3(vertices, 252 + i * 6, 0.5f - i * 0.03125f, 0.875f, 0.0625f, 0.01171875f, 0.0078125f);
        else rect3(vertices, 252 + i * 6, 2.0f, 2.0f, 0.0625f, 0.0078125f, 0.0078125f);
    }
    /* Particle ribbons around the ball and both paddles. */
    for (int i = 0; i < 8; i += 1) {
        float a = g->clock * 4.0f + i;
        rect3(vertices, 282 + i * 6, g->ballx + sin(a) * 0.09375f, g->bally + cos(a) * 0.09375f, 0.09375f + i * 0.0078125f, 0.0078125f, 0.0078125f);
    }
    for (int i = 0; i < 4; i += 1) {
        float a = g->clock * 3.0f + i;
        rect3(vertices, 330 + i * 6, -0.875f + sin(a) * 0.0625f, g->left + cos(a) * 0.28125f, 0.078125f, 0.0078125f, 0.0078125f);
        rect3(vertices, 354 + i * 6, 0.875f + sin(a) * 0.0625f, g->right + cos(a) * 0.28125f, 0.078125f, 0.0078125f, 0.0078125f);
    }
}

vertex float4 pong_vs(device float4* vertices, vertex_id vid) { return vertices[vid]; }

fragment float4 pong_fs(float4 pos) {
    float wave = 0.5f + 0.5f * sin(pos.x * 4.0f + pos.y * 3.0f + pos.z * 8.0f);
    if (pos.z > 0.96875f) return float4(0.25f + wave * 0.25f, 0.0f, 0.015625f + wave * 0.0625f, 1.0f);
    if (pos.z > 0.953125f) return float4(0.75f + wave * 0.25f, 0.25f + wave * 0.25f, 0.015625f, 1.0f);
    if (pos.z > 0.9375f) return float4(0.75f + wave * 0.1875f, 0.03125f, 0.015625f + wave * 0.03125f, 1.0f);
    if (pos.z > 0.921875f) return float4(0.015625f, 0.375f + wave * 0.25f, 0.1875f + wave * 0.125f, 1.0f);
    if (pos.z > 0.90625f) {
        float stars = sin(pos.x * 64.0f + pos.z * 128.0f) * sin(pos.y * 96.0f - pos.z * 64.0f);
        if (stars > 0.9375f) return float4(0.875f, 0.9375f, 1.0f, 1.0f);
        return float4(0.0f, 0.015625f + wave * 0.03125f, 0.125f + wave * 0.125f, 1.0f);
    }
    if (pos.z > 0.890625f) return float4(0.015625f + wave * 0.25f, 0.03125f + wave * 0.1875f, 0.1875f + wave * 0.5f, 1.0f);
    if (pos.z > 0.375f) return float4(0.0f, 0.5f + wave * 0.25f, 0.75f + wave * 0.25f, 1.0f);
    if (pos.z > 0.3125f) return float4(0.0f, 0.625f + wave * 0.25f, 1.0f, 0.0625f);
    if (pos.z > 0.25f) return float4(0.75f, 0.03125f, 0.875f + wave * 0.125f, 0.125f);
    if (pos.z > 0.203125f) return float4(1.0f, 0.0f, 0.5f + wave * 0.25f, 0.25f);
    if (pos.z > 0.125f) return float4(0.75f + wave * 0.25f, 0.03125f, 0.5f + wave * 0.25f, 1.0f);
    return float4(0.875f + wave * 0.125f, 0.875f + wave * 0.125f, 1.0f, 1.0f);
}
