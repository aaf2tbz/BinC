struct Game { float ballx, bally, vx, vy, left, right; };

void rect(device float4* v, int b, float cx, float cy, float hw, float hh) {
    v[b + 0] = float4(cx - hw, cy - hh, 0.0f, 1.0f);
    v[b + 1] = float4(cx + hw, cy - hh, 0.0f, 1.0f);
    v[b + 2] = float4(cx + hw, cy + hh, 0.0f, 1.0f);
    v[b + 3] = float4(cx - hw, cy - hh, 0.0f, 1.0f);
    v[b + 4] = float4(cx + hw, cy + hh, 0.0f, 1.0f);
    v[b + 5] = float4(cx - hw, cy + hh, 0.0f, 1.0f);
}

kernel void update(device Game* g, device float4* vertices, float dt, float input) {
    g->ballx += g->vx * dt;
    g->bally += g->vy * dt;
    g->left += input * dt * 2.5f;
    if (g->left > 0.75f) g->left = 0.75f;
    if (g->left < -0.75f) g->left = -0.75f;
    if (g->bally > 0.875f || g->bally < -0.875f) g->vy = -g->vy;
    if (g->ballx > 0.875f) g->vx = -fabs(g->vx);
    if (g->ballx < -0.875f) g->vx = fabs(g->vx);
    if (g->ballx < -0.75f && fabs(g->bally - g->left) < 0.25f) g->vx = fabs(g->vx);
    if (g->ballx > 0.75f && fabs(g->bally - g->right) < 0.25f) g->vx = -fabs(g->vx);
    rect(vertices, 0, -0.875f, g->left, 0.03125f, 0.25f);
    rect(vertices, 6, 0.875f, g->right, 0.03125f, 0.25f);
    rect(vertices, 12, g->ballx, g->bally, 0.03125f, 0.03125f);
}

vertex float4 pong_vs(device float4* vertices, vertex_id vid) {
    return vertices[vid];
}

fragment float4 pong_fs() {
    return float4(1.0f, 1.0f, 1.0f, 1.0f);
}
