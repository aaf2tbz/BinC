struct Pair {
    float x;
    float y;
};

/* plain function: struct param by value, struct return */
Pair make_pair(float a, float b) {
    Pair p;
    p.x = a;
    p.y = b;
    return p;
}

/* plain function: struct param read + modified into a new struct */
Pair swap(Pair p) {
    Pair q;
    q.x = p.y;
    q.y = p.x;
    return q;
}

kernel void k(device float* out, coord1D i) {
    Pair a = make_pair(3.0f, 4.0f);     /* struct return -> init */
    Pair b = swap(a);                    /* struct param + return */
    Pair c;
    c = a;                               /* struct assignment */
    c.x = c.x + 10.0f;
    out[i]      = a.x + a.y;             /* 7 */
    out[i + 8]  = b.x + b.y;             /* 7 */
    out[i + 16] = c.x + c.y;             /* 17 */
    out[i + 24] = make_pair(1.0f, 2.0f).y; /* field access on a struct value: 2 */
}
